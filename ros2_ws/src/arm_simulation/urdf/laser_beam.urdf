<?xml version="1.0"?>
<robot name="laser_beam">
  <link name="beam_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <!-- Rotar 90 grados en Y para alinear el cilindro (que por defecto va en Z) a lo largo del eje X local -->
      <origin xyz="0.1875 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <!-- Radio 1.5mm, longitud 0.375m -->
        <cylinder radius="0.0015" length="0.375"/>
      </geometry>
      <material name="laser_red">
        <color rgba="1.0 0.0 0.0 0.8"/>
      </material>
    </visual>
  </link>
  <gazebo reference="beam_link">
    <material>Gazebo/Red</material>
    <turnGravityOff>true</turnGravityOff>
  </gazebo>
</robot>

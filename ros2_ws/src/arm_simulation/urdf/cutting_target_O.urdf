<?xml version="1.0"?>
<robot name="cutting_target_o">
  <!-- Link principal del cilindro de corte -->
  <link name="target_link">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <!-- Cilindro echado horizontalmente a lo largo del eje Y local (roll = 90 deg, pitch = 105 deg (1.832595 rad) para rotar la textura ligeramente hacia arriba) -->
      <origin xyz="0 0 0" rpy="1.57079632679 1.832595 0"/>
      <geometry>
        <!-- Radio 1.5 cm (30 mm diametro), Altura 6 cm (60 mm de longitud) -->
        <cylinder radius="0.015" length="0.06"/>
      </geometry>
      <material name="target_material_o">
        <color rgba="0.0 0.8 0.8 1.0"/>
        <texture filename="package://arm_simulation/materials/textures/target_draw_O.png"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.06"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="target_link">
    <visual>
      <material>
        <script>
          <uri>model://arm_simulation/materials/scripts</uri>
          <uri>model://arm_simulation/materials/textures</uri>
          <name>CuttingTarget/Drawing_O</name>
        </script>
      </material>
    </visual>
  </gazebo>

  <!-- ==================== SISTEMA DE REFERENCIA: BASE ==================== -->
  <!-- Eje X (Rojo) de la Base -->
  <link name="target_base_x">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
    <visual>
      <origin xyz="0.01 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.0004" length="0.02"/>
      </geometry>
      <material name="base_red">
        <color rgba="1.0 0.0 0.0 0.8"/>
      </material>
    </visual>
  </link>
  <joint name="target_base_x_joint" type="fixed">
    <origin xyz="0 0 -0.015" rpy="0 0 0"/>
    <parent link="target_link"/>
    <child link="target_base_x"/>
  </joint>
  <gazebo reference="target_base_x">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- Eje Y (Verde) de la Base -->
  <link name="target_base_y">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
    <visual>
      <origin xyz="0 0.01 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.0004" length="0.02"/>
      </geometry>
      <material name="base_green">
        <color rgba="0.0 1.0 0.0 0.8"/>
      </material>
    </visual>
  </link>
  <joint name="target_base_y_joint" type="fixed">
    <origin xyz="0 0 -0.015" rpy="0 0 0"/>
    <parent link="target_link"/>
    <child link="target_base_y"/>
  </joint>
  <gazebo reference="target_base_y">
    <material>Gazebo/Green</material>
  </gazebo>

  <!-- Eje Z (Azul) de la Base -->
  <link name="target_base_z">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0004" length="0.02"/>
      </geometry>
      <material name="base_blue">
        <color rgba="0.0 0.0 1.0 0.8"/>
      </material>
    </visual>
  </link>
  <joint name="target_base_z_joint" type="fixed">
    <origin xyz="0 0 -0.015" rpy="0 0 0"/>
    <parent link="target_link"/>
    <child link="target_base_z"/>
  </joint>
  <gazebo reference="target_base_z">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Hacer el objeto estático en Gazebo -->
  <gazebo>
    <static>true</static>
  </gazebo>
</robot>

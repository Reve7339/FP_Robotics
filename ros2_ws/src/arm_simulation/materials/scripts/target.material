material CuttingTarget/Drawing
{
  technique
  {
    pass
    {
      ambient 1.0 1.0 1.0 1.0
      diffuse 1.0 1.0 1.0 1.0
      specular 0.2 0.2 0.2 1.0 12.5
      emissive 0.1 0.1 0.1 1.0

      texture_unit
      {
        texture target_draw.png
        filtering bilinear
      }
    }
  }
}

